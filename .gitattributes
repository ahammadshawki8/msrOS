# Normalize to LF in the repository regardless of the OS a commit came from.
# This repo installs on Windows, macOS, and Linux, and ships an executable
# Node script whose shebang breaks under CRLF if it is ever run directly.
* text=auto eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.gif binary
*.mp4 binary
*.srt text eol=lf
